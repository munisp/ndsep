# NDSEP Docker Compose Environment Variables
# Copy this file to .env and customize for your environment.
# All values below are development defaults — NEVER use these in production.

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Full database connection string (overrides individual PG vars)
DATABASE_URL=postgresql://ndsep_user:CHANGE_ME@postgres:5432/ndsep_db

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# MinIO / Lakehouse
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# JWT (minimum 32 characters)
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_CHAR_STRING

# Osiris OSINT Integration
OSIRIS_URL=https://osirisai.live
OSIRIS_SCANNER_KEY=

# SOCint — Unified CTI Hub (indicators, detection rules, dark web, cases)
SOCINT_URL=http://socint:8000
SOCINT_API_KEY=

# Phantom Tide — Maritime Intelligence (Gulf of Guinea / Niger Delta)
PHANTOM_TIDE_URL=http://phantomtide:5000
PHANTOM_TIDE_API_KEY=
AISSTREAM_API_KEY=

# Wazuh — SIEM & Compliance Monitoring (NDPA/NDPR)
WAZUH_URL=https://wazuh-manager:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=

# SIGINT — Compound Threat Correlation (aircraft, vessels, seismic, fires)
SIGINT_URL=http://sigint:3001
SIGINT_API_KEY=
NASA_FIRMS_KEY=

# Estorides — Knowledge Graph & Entity Resolution
ESTORIDES_URL=http://estorides:8080
ESTORIDES_API_KEY=
LLM_PROVIDER=openai
LLM_API_KEY=
