# Local-only mTLS callback test values. Never use in staging or production.
NODE_ENV=development
DATABASE_URL=postgresql://ndsep_local_user:replace-local-password@host.docker.internal:5432/ndsep_local
MOJALOOP_CALLBACK_HMAC_SECRET=local-only-test-secret-change-this-to-32-plus-random-characters
MOJALOOP_CALLBACK_MTLS_SUBJECT_DN=CN=local-provider,O=NDSEP Test,C=NG
MOJALOOP_CALLBACK_GATEWAY_ATTESTATION=local-only-gateway-attestation-change-this-to-32-plus-random-characters
MOJALOOP_CALLBACK_MTLS_REQUIRED=false
API_PORT=3000
ENVOY_TLS_PORT=8443
ENVOY_ADMIN_PORT=9901
