# IDLR-PTS target-environment template — placeholders only; do not use default values in production.
NODE_ENV=production
PORT=3000
CORS_ALLOWED_ORIGINS=https://land.example.gov.ng,https://ops.example.gov.ng
DATABASE_URL=mysql://<user>:<password>@<mysql-host>:3306/idlr_pts
PAYMENT_AUDIT_POSTGRES_URL=postgresql://<user>:<password>@<postgres-host>:5432/idlr_payment
RECOVERY_AUDIT_POSTGRES_URL=postgresql://<user>:<password>@<postgres-host>:5432/idlr_recovery
INTEGRATION_SETTINGS_ENCRYPTION_KEY=<injected-by-secret-manager>
EXPO_PUBLIC_OIDC_ISSUER=https://<keycloak-host>/realms/idlrpts
EXPO_PUBLIC_OIDC_CLIENT_ID=idlrpts-mobile
EXPO_PUBLIC_OIDC_REDIRECT_URI=idlrpts://oauth/callback
OIDC_ISSUER=https://<keycloak-host>/realms/idlrpts
OIDC_AUDIENCE=idlrpts-api
OIDC_JWKS_URL=https://<keycloak-host>/realms/idlrpts/protocol/openid-connect/certs
RECOVERY_WEBAUTHN_ORIGIN=https://ops.example.gov.ng
RECOVERY_WEBAUTHN_RP_ID=ops.example.gov.ng
RECOVERY_KMS_REGION=<kms-region>
RECOVERY_KMS_KEY_ID=<approved-kms-destination-key-arn>
RECOVERY_REPLAY_URL=https://<allowlisted-replay-worker-host>/api/recovery/replay
RECOVERY_REPLAY_ALLOWED_HOSTS=<allowlisted-replay-worker-host>
RECOVERY_REPLAY_SHARED_SECRET=<injected-by-secret-manager>
DIAGNOSTIC_ATTESTATION_KEY_ID=<kms-key-version-id>
DIAGNOSTIC_ATTESTATION_ED25519_PRIVATE_KEY=<injected-by-kms-or-secret-manager>
METRICS_BEARER_TOKEN=<injected-by-secret-manager>
SERVE_LOCAL_UPLOADS=false
OBJECT_STORAGE_ENDPOINT=https://<s3-compatible-endpoint>
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_BUCKET=<evidence-bucket>
OBJECT_STORAGE_ACCESS_KEY_ID=<injected-by-secret-manager>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<injected-by-secret-manager>
OBJECT_STORAGE_PUBLIC_BASE_URL=https://<controlled-evidence-domain>
