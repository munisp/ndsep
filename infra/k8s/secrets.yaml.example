###############################################################################
# NDSEP Kubernetes Secrets — Sensitive credentials template
# Copy to secrets.yaml, fill in base64-encoded values, then apply.
# NEVER commit secrets.yaml to version control.
#
# Encode values: echo -n "your-value" | base64
# Apply: kubectl apply -f infra/k8s/secrets.yaml
###############################################################################
apiVersion: v1
kind: Secret
metadata:
  name: ndsep-secrets
  namespace: ndsep
  labels:
    app: ndsep-api
    app.kubernetes.io/part-of: ndsep-platform
type: Opaque
stringData:
  # ─── Database ─────────────────────────────────────────────────────────────
  DATABASE_URL: "postgresql://ndsep_user:CHANGE_ME@postgres:5432/ndsep_db"
  POSTGRES_PASSWORD: "CHANGE_ME_32_CHAR_MIN"

  # ─── Authentication ───────────────────────────────────────────────────────
  JWT_SECRET: "CHANGE_ME_64_CHAR_MIN_RANDOM_STRING"

  # ─── Manus OAuth ─────────────────────────────────────────────────────────
  VITE_APP_ID: "your-manus-app-id"
  OAUTH_SERVER_URL: "https://api.manus.im"
  VITE_OAUTH_PORTAL_URL: "https://manus.im"

  # ─── Manus Built-in APIs ─────────────────────────────────────────────────
  BUILT_IN_FORGE_API_KEY: "your-forge-api-key"
  BUILT_IN_FORGE_API_URL: "https://api.manus.im"
  VITE_FRONTEND_FORGE_API_KEY: "your-frontend-forge-api-key"
  VITE_FRONTEND_FORGE_API_URL: "https://api.manus.im"

  # ─── SMS (Termii) ─────────────────────────────────────────────────────────
  TERMII_API_KEY: "your-termii-api-key"
  TERMII_SENDER_ID: "NDSEP"
  TERMII_API_URL: "https://api.ng.termii.com"

  # ─── Email (SendGrid) ─────────────────────────────────────────────────────
  SENDGRID_API_KEY: "SG.your-sendgrid-api-key"
  EMAIL_FROM: "noreply@ndsep.gov.ng"
  EMAIL_FROM_NAME: "NDSEP Compliance Platform"

  # ─── Stripe ───────────────────────────────────────────────────────────────
  STRIPE_SECRET_KEY: "sk_live_your-stripe-secret-key"
  STRIPE_WEBHOOK_SECRET: "whsec_your-webhook-secret"
  VITE_STRIPE_PUBLISHABLE_KEY: "pk_live_your-publishable-key"

  # ─── Storage (S3/MinIO) ───────────────────────────────────────────────────
  AWS_ACCESS_KEY_ID: "your-access-key-id"
  AWS_SECRET_ACCESS_KEY: "your-secret-access-key"
  AWS_REGION: "af-south-1"
  AWS_S3_BUCKET: "ndsep-documents"

  # ─── Redis ────────────────────────────────────────────────────────────────
  REDIS_URL: "redis://:CHANGE_ME@redis:6379"

  # ─── Signing Certificate ─────────────────────────────────────────────────
  PDF_SIGNING_CERT_PATH: "/etc/ndsep/certs/signing.p12"
  PDF_SIGNING_CERT_PASSWORD: "CHANGE_ME"

  # ─── Owner Info ───────────────────────────────────────────────────────────
  OWNER_OPEN_ID: "your-owner-open-id"
  OWNER_NAME: "NDPC Administrator"
