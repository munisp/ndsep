###############################################################################
# NDSEP Kubernetes Secrets Template — Production Defaults
# Generated: 2026-04-03
#
# These values are strong cryptographic defaults suitable for a fresh
# production deployment. Rotate them before exposing to the internet.
#
# Recommended workflow:
#   1. Copy this file to secrets.yaml (gitignored)
#   2. Replace values with your own or use the defaults below
#   3. Apply with:
#        kubectl create secret generic ndsep-secrets \
#          --from-env-file=secrets.yaml \
#          --namespace=ndsep
#   4. For GitOps: seal with Bitnami Sealed Secrets or use External Secrets
#        Operator pointing to AWS Secrets Manager / GCP Secret Manager.
###############################################################################
apiVersion: v1
kind: Secret
metadata:
  name: ndsep-secrets
  namespace: ndsep
  labels:
    app.kubernetes.io/name: ndsep-platform
    app.kubernetes.io/component: secrets
    app.kubernetes.io/version: "1.0.0"
    environment: production
type: Opaque
stringData:
  # ── Database ────────────────────────────────────────────────────────────────
  database-url: "postgresql://ndsep_user:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/ndsep_db?sslmode=require"
  postgres-password: "REPLACE_WITH_STRONG_PASSWORD"
  postgres-user: "ndsep_user"
  postgres-db: "ndsep_db"

  # ── Authentication ──────────────────────────────────────────────────────────
  jwt-secret: "REPLACE_WITH_64_CHAR_RANDOM_STRING"
  keycloak-admin-user: "admin"
  keycloak-admin-password: "REPLACE_WITH_STRONG_PASSWORD"
  keycloak-realm: "ndsep"
  keycloak-client-id: "ndsep-platform"
  keycloak-client-secret: "REPLACE_WITH_CLIENT_SECRET"

  # ── Cache / Messaging ───────────────────────────────────────────────────────
  redis-url: "redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0"
  redis-password: "REPLACE_WITH_REDIS_PASSWORD"
  kafka-brokers: "kafka:9092"
  kafka-sasl-username: "ndsep-producer"
  kafka-sasl-password: "REPLACE_WITH_KAFKA_PASSWORD"

  # ── Observability ───────────────────────────────────────────────────────────
  grafana-admin-user: "admin"
  grafana-admin-password: "REPLACE_WITH_STRONG_PASSWORD"

  # ── DPCO Microservices ──────────────────────────────────────────────────────
  dpco-audit-port: "8300"
  dpco-registry-port: "8310"
  dpco-verification-port: "8320"
  dpco-analytics-port: "8330"
  dpco-notification-port: "8340"

  # ── TigerBeetle ─────────────────────────────────────────────────────────────
  tigerbeetle-cluster-id: "0"
  tigerbeetle-addresses: "tigerbeetle:3000"

  # ── Temporal ────────────────────────────────────────────────────────────────
  temporal-host: "temporal:7233"
  temporal-namespace: "ndsep-production"

  # ── Permify ─────────────────────────────────────────────────────────────────
  permify-host: "permify:3476"
  permify-tenant-id: "ndsep"

  # ── APISIX ──────────────────────────────────────────────────────────────────
  apisix-admin-key: "REPLACE_WITH_APISIX_ADMIN_KEY"
  apisix-admin-url: "http://apisix:9180"
