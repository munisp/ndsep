{{/* NDSEP Alertmanager Templates */}}

{{/* Severity emoji */}}
{{ define "ndsep.severity.emoji" -}}
  {{- if eq .CommonLabels.severity "critical" }}🚨
  {{- else if eq .CommonLabels.severity "warning" }}⚠️
  {{- else if eq .CommonLabels.severity "info" }}ℹ️
  {{- else }}🔔
  {{- end }}
{{- end }}

{{/* Status emoji */}}
{{ define "ndsep.status.emoji" -}}
  {{- if eq .Status "firing" }}🔴
  {{- else }}✅
  {{- end }}
{{- end }}

{{/* Short alert title */}}
{{ define "ndsep.title" -}}
  {{ template "ndsep.status.emoji" . }} [{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}
{{- end }}

{{/* Full alert body for Slack */}}
{{ define "ndsep.slack.body" }}
*Platform:* NDSEP — National Data Sovereignty Enforcement Platform
*Environment:* Production
*Severity:* {{ .CommonLabels.severity | toUpper }}
*Team:* {{ .CommonLabels.team | default "platform" }}

{{ range .Alerts }}
---
*Alert:* {{ .Annotations.summary }}
*Description:* {{ .Annotations.description }}
*Instance:* {{ .Labels.instance | default "N/A" }}
*Started:* {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}
{{ if .EndsAt }}*Ended:* {{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}{{ end }}
{{ end }}
{{ end }}

{{/* Email HTML body */}}
{{ define "ndsep.email.html" }}
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body style="font-family:Arial,sans-serif;color:#1a1a2e;background:#f8fafc;padding:20px">
  <div style="max-width:600px;margin:0 auto;background:#fff;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb">
    <div style="background:#1a3a5c;padding:20px;color:#fff">
      <h1 style="margin:0;font-size:20px">⚠️ NDSEP Platform Alert</h1>
      <p style="margin:4px 0 0;opacity:0.8;font-size:13px">National Data Sovereignty Enforcement Platform</p>
    </div>
    <div style="padding:24px">
      <table style="width:100%;border-collapse:collapse;margin-bottom:20px">
        <tr style="background:#f1f5f9">
          <td style="padding:8px 12px;border:1px solid #e5e7eb;font-weight:600;width:140px">Status</td>
          <td style="padding:8px 12px;border:1px solid #e5e7eb;font-weight:700;color:{{ if eq .Status "firing" }}#dc2626{{ else }}#16a34a{{ end }}">{{ .Status | toUpper }}</td>
        </tr>
        <tr>
          <td style="padding:8px 12px;border:1px solid #e5e7eb;font-weight:600">Alert</td>
          <td style="padding:8px 12px;border:1px solid #e5e7eb">{{ .GroupLabels.alertname }}</td>
        </tr>
        <tr style="background:#f1f5f9">
          <td style="padding:8px 12px;border:1px solid #e5e7eb;font-weight:600">Severity</td>
          <td style="padding:8px 12px;border:1px solid #e5e7eb">{{ .CommonLabels.severity | toUpper }}</td>
        </tr>
      </table>
      {{ range .Alerts }}
      <div style="background:#fef9c3;border:1px solid #fde047;border-radius:6px;padding:16px;margin-bottom:16px">
        <p style="margin:0 0 8px;font-weight:600">{{ .Annotations.summary }}</p>
        <p style="margin:0;color:#374151;font-size:14px">{{ .Annotations.description }}</p>
      </div>
      {{ end }}
      <p style="font-size:13px;color:#6b7280">This alert was generated by NDSEP Prometheus Alertmanager.</p>
    </div>
  </div>
</body>
</html>
{{ end }}
