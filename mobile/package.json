{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run --maxWorkers=1",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "qr": "node scripts/generate_qr.mjs",
    "migrate:payment-audit": "tsx scripts/migrate-payment-audit.ts",
    "generate:scanner-sounds": "node scripts/create-scanner-feedback-wav.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/elements": "^2.9.40",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "@trpc/server": "11.7.2",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.14",
    "expo-build-properties": "^57.0.15",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "^57.0.2",
    "expo-location": "~57.0.14",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-print": "^57.0.1",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "^57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "express": "^4.22.1",
    "jose": "6.1.0",
    "leaflet": "^1.9.4",
    "mysql2": "^3.22.0",
    "nativewind": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/cookie": "^0.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.25",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.18",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.4"
}
