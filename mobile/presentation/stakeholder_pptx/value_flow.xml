  <shape id="benefit-1" type="rect" x="100" y="470" width="330" height="138" fill="surface" stroke="hairline" stroke-width="1"/>
  <icon id="benefit-1-icon" name="building-2" x="124" y="496" width="30" height="30" color="primary"/>
  <text id="benefit-1-title" x="164" y="492" width="236" height="28" font="body" size="20" color="ink" wrap="false"><strong>Public coordination</strong></text>
  <text id="benefit-1-body" x="124" y="534" width="278" height="56" font="body" size="17" color="muted" line-height="1.35"><p>Federal and state institutions see the same case history, deadlines, and evidence state.</p></text>

  <shape id="benefit-2" type="rect" x="475" y="470" width="330" height="138" fill="surface" stroke="hairline" stroke-width="1"/>
  <icon id="benefit-2-icon" name="file-check" x="499" y="496" width="30" height="30" color="accent"/>
  <text id="benefit-2-title" x="539" y="492" width="236" height="28" font="body" size="20" color="ink" wrap="false"><strong>Decision quality</strong></text>
  <text id="benefit-2-body" x="499" y="534" width="278" height="56" font="body" size="17" color="muted" line-height="1.35"><p>Evidence, field validation, and structured review reduce avoidable back-and-forth in approvals.</p></text>

  <shape id="benefit-3" type="rect" x="850" y="470" width="330" height="138" fill="surface" stroke="hairline" stroke-width="1"/>
  <icon id="benefit-3-icon" name="badge-dollar-sign" x="874" y="496" width="30" height="30" color="#B45309"/>
  <text id="benefit-3-title" x="914" y="492" width="236" height="28" font="body" size="20" color="ink" wrap="false"><strong>Economic outcomes</strong></text>
  <text id="benefit-3-body" x="874" y="534" width="278" height="56" font="body" size="17" color="muted" line-height="1.35"><p>Faster housing, stronger fee capture, safer investment, and more trusted permitting records.</p></text>

