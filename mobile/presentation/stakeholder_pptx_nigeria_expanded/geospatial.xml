  <shape id="native-note" type="rect" x="58" y="486" width="1164" height="42" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1"/>
  <text id="native-note-copy" x="76" y="498" width="1128" height="18" font="caption" size="13" color="ink" align="center" wrap="false">Important: the richer live mobile map surface is available on native device builds; the web preview shown here presents parcel intelligence and geospatial readiness without overstating the map layer.</text>
  <shape id="cap1" type="rect" x="58" y="548" width="274" height="98" fill="surface" stroke="border" stroke-width="1"/>
  <text id="cap1-title" x="76" y="566" width="238" height="22" font="body" size="18" color="ink"><p><strong>Parcel-linked casework</strong></p></text>
  <text id="cap1-copy" x="76" y="592" width="238" height="36" font="body" size="14" color="muted">Every approval stays connected to parcel identity, owner context, and title status.</text>
  <shape id="cap2" type="rect" x="352" y="548" width="274" height="98" fill="surface" stroke="border" stroke-width="1"/>
  <text id="cap2-title" x="370" y="566" width="238" height="22" font="body" size="18" color="ink"><p><strong>Geofence alerts</strong></p></text>
  <text id="cap2-copy" x="370" y="592" width="238" height="36" font="body" size="14" color="muted">Location-aware notifications turn field entry and exit events into workflow signals.</text>
  <shape id="cap3" type="rect" x="646" y="548" width="274" height="98" fill="surface" stroke="border" stroke-width="1"/>
  <text id="cap3-title" x="664" y="566" width="238" height="22" font="body" size="18" color="ink"><p><strong>Offline geofence replay</strong></p></text>
  <text id="cap3-copy" x="664" y="592" width="238" height="36" font="body" size="14" color="muted">Delayed field events are replayed and reconciled when service returns.</text>
  <shape id="cap4" type="rect" x="940" y="548" width="282" height="98" fill="surface" stroke="border" stroke-width="1"/>
  <text id="cap4-title" x="958" y="566" width="246" height="22" font="body" size="18" color="ink"><p><strong>GeoLibre handoff</strong></p></text>
  <text id="cap4-copy" x="958" y="592" width="246" height="36" font="body" size="14" color="muted">Spatial review can move into a dedicated geospatial workspace without losing workflow continuity.</text>
