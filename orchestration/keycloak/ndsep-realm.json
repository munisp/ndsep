{
  "realm": "ndsep",
  "displayName": "National Data Sovereignty Enforcement Platform",
  "displayNameHtml": "<strong>NDSEP</strong>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": true,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "accessTokenLifespan": 600,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 604800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "webAuthnPolicyRpEntityName": "NDSEP",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full platform administrator — all permissions",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "government_staff",
        "description": "Government enforcement officer — issue penalties, approve transfers",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "auditor",
        "description": "Independent auditor — read-only access to audit trails and reports",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "org_admin",
        "description": "Organisation administrator — submit portal applications and view certificates",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "org_user",
        "description": "Organisation staff — submit portal applications",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "regulator",
        "description": "Regulatory body — approve cross-border transfers and generate reports",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "legal_officer",
        "description": "Legal officer — approve penalties and review audit trails",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "finance_officer",
        "description": "Finance officer — manage financial records and reconciliation",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "tech_officer",
        "description": "Technical officer — manage network and ML configuration",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "data_protection_officer",
        "description": "DPO — approve cross-border transfers and issue compliance certificates",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "groups": [
    {
      "name": "government",
      "realmRoles": ["government_staff", "auditor"]
    },
    {
      "name": "organisations",
      "realmRoles": ["org_admin", "org_user"]
    },
    {
      "name": "regulators",
      "realmRoles": ["regulator", "legal_officer", "finance_officer"]
    },
    {
      "name": "technical",
      "realmRoles": ["tech_officer", "data_protection_officer"]
    }
  ],
  "clients": [
    {
      "clientId": "ndsep-platform",
      "name": "NDSEP Platform",
      "description": "National Data Sovereignty Enforcement Platform web application",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": true,
      "redirectUris": [
        "https://ndsep.nitda.gov.ng/*",
        "https://staging.ndsep.nitda.gov.ng/*"
      ],
      "webOrigins": [
        "https://ndsep.nitda.gov.ng",
        "https://staging.ndsep.nitda.gov.ng"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "saml.assertion.signature": "false",
        "saml.force.post.binding": "false",
        "saml.multivalued.roles": "false",
        "saml.encrypt": "false",
        "saml.server.signature": "false",
        "saml.server.signature.keyinfo.ext": "false",
        "exclude.session.state.from.auth.response": "false",
        "saml_force_name_id_format": "false",
        "saml.client.signature": "false",
        "tls.client.certificate.bound.access.tokens": "true",
        "pkce.code.challenge.method": "S256",
        "saml.authnstatement": "false",
        "display.on.consent.screen": "false",
        "saml.onetimeuse.condition": "false"
      },
      "authorizationSettings": {
        "allowRemoteResourceManagement": false,
        "policyEnforcementMode": "ENFORCING",
        "resources": [
          {
            "name": "dashboard",
            "displayName": "Government Dashboard",
            "uris": ["/"],
            "scopes": [{"name": "view"}]
          },
          {
            "name": "violations",
            "displayName": "Compliance Violations",
            "uris": ["/compliance", "/api/trpc/compliance.*"],
            "scopes": [{"name": "view"}, {"name": "issue"}, {"name": "remediate"}]
          },
          {
            "name": "penalties",
            "displayName": "Financial Penalties",
            "uris": ["/financial", "/api/trpc/financial.*"],
            "scopes": [{"name": "view"}, {"name": "issue"}, {"name": "approve"}, {"name": "pay"}]
          },
          {
            "name": "transfers",
            "displayName": "Cross-Border Transfers",
            "uris": ["/transfers", "/api/trpc/transfers.*"],
            "scopes": [{"name": "view"}, {"name": "submit"}, {"name": "approve"}, {"name": "deny"}]
          },
          {
            "name": "audit",
            "displayName": "Audit Trail",
            "uris": ["/siem", "/api/trpc/siem.*"],
            "scopes": [{"name": "view"}]
          },
          {
            "name": "portal",
            "displayName": "Organisation Portal",
            "uris": ["/portal", "/portal-review", "/api/trpc/portal.*"],
            "scopes": [{"name": "submit"}, {"name": "review"}, {"name": "certify"}]
          },
          {
            "name": "network",
            "displayName": "Network DPI",
            "uris": ["/network", "/bgp", "/pcap", "/api/trpc/network.*"],
            "scopes": [{"name": "view"}, {"name": "manage"}, {"name": "block"}]
          },
          {
            "name": "financials",
            "displayName": "Financial Records",
            "uris": ["/financial", "/api/trpc/financial.*"],
            "scopes": [{"name": "view"}, {"name": "manage"}, {"name": "reconcile"}]
          },
          {
            "name": "roles",
            "displayName": "Role Management",
            "uris": ["/roles", "/api/trpc/users.*"],
            "scopes": [{"name": "view"}, {"name": "manage"}]
          },
          {
            "name": "orchestration",
            "displayName": "Orchestration Layer",
            "uris": ["/orchestration", "/api/trpc/orchestration.*"],
            "scopes": [{"name": "view"}, {"name": "manage"}]
          }
        ],
        "policies": [
          {
            "name": "admin-policy",
            "description": "Admins have full access",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {"roles": "[{\"id\":\"admin\",\"required\":true}]"}
          },
          {
            "name": "government-staff-policy",
            "description": "Government staff can issue violations and penalties",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {"roles": "[{\"id\":\"government_staff\",\"required\":true}]"}
          },
          {
            "name": "auditor-policy",
            "description": "Auditors have read-only access",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {"roles": "[{\"id\":\"auditor\",\"required\":true}]"}
          },
          {
            "name": "org-admin-policy",
            "description": "Org admins can submit portal applications",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {"roles": "[{\"id\":\"org_admin\",\"required\":true}]"}
          },
          {
            "name": "regulator-policy",
            "description": "Regulators can approve transfers and generate reports",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {"roles": "[{\"id\":\"regulator\",\"required\":true}]"}
          }
        ],
        "scopes": [
          {"name": "view"},
          {"name": "manage"},
          {"name": "issue"},
          {"name": "approve"},
          {"name": "deny"},
          {"name": "submit"},
          {"name": "review"},
          {"name": "certify"},
          {"name": "block"},
          {"name": "reconcile"},
          {"name": "remediate"},
          {"name": "pay"}
        ],
        "decisionStrategy": "UNANIMOUS"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    },
    {
      "alias": "webauthn-register",
      "name": "WebAuthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 20
    }
  ],
  "identityProviders": [],
  "identityProviderMappers": [],
  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Allowed Protocol Mapper Types",
        "providerId": "allowed-protocol-mappers",
        "subType": "anonymous",
        "config": {
          "allowed-protocol-mapper-types": [
            "oidc-usermodel-property-mapper",
            "oidc-full-name-mapper",
            "oidc-sha256-pairwise-sub-mapper",
            "oidc-address-mapper",
            "saml-user-attribute-mapper",
            "saml-role-list-mapper",
            "saml-user-property-mapper",
            "oidc-usermodel-attribute-mapper"
          ]
        }
      }
    ]
  },
  "internationalizationEnabled": false,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "LOGOUT_ERROR",
    "REGISTER", "REGISTER_ERROR", "UPDATE_PASSWORD", "UPDATE_PASSWORD_ERROR",
    "CLIENT_LOGIN", "CLIENT_LOGIN_ERROR", "CODE_TO_TOKEN", "CODE_TO_TOKEN_ERROR"
  ]
}
