    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:force": "FORCE_SEED=1 node scripts/seed.mjs",
