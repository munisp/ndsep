{
  "name": "ndsep",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:force": "FORCE_SEED=1 node scripts/seed.mjs",
    "seed:all": "node scripts/seed-comprehensive.mjs",
    "seed:remaining": "node scripts/seed-remaining-synthetic-fixtures.mjs",
    "seed:all:force": "FORCE_SEED=1 node scripts/seed-comprehensive.mjs",
    "seed:verify": "node scripts/verify-synthetic-seed-coverage.mjs",
    "seed:verify:scenario": "node scripts/verify-synthetic-fixture-scenario.mjs",
    "e2e": "playwright test",
    "e2e:release-smoke": "playwright test e2e/release-smoke.spec.ts",
    "e2e:release-smoke:chromium": "playwright test e2e/release-smoke.spec.ts --project=chromium --workers=1 --timeout=30000 --global-timeout=300000",
    "e2e:critical": "playwright test e2e/auth.spec.ts e2e/critical-flows.spec.ts e2e/dpco-onboarding.spec.ts e2e/penalty-enforcement.spec.ts",
    "e2e:extended": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:test": "playwright test",
    "e2e:test:ui": "playwright test --ui",
    "e2e:test:debug": "playwright test --headed --debug",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
