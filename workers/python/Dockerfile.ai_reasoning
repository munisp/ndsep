# NOC AI Reasoning Engine (noc_agent_reasoning.py) — LLM root-cause analysis
# and remediation planning. Image for the noc-ai-reasoning Deployment
# (infra/k8s/noc-ai-agents.yaml) and for the k8sReadiness check
# (server/k8sReadiness.ts expects workers/python/Dockerfile.ai_reasoning).
#
# Build context must be workers/python:
#   docker build -f Dockerfile.ai_reasoning -t ndsep/noc-ai-reasoning:latest .
#
# ─── Stage 1: Builder ────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Runtime deps of noc_agent_reasoning.py: FastAPI + uvicorn (HTTP API on 8195),
# psycopg2 (PostgreSQL), requests (Ollama/relay/action calls), pydantic.
RUN pip install --no-cache-dir --user \
    fastapi \
    "uvicorn[standard]" \
    psycopg2-binary \
    requests \
    pydantic

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/.local /root/.local

WORKDIR /app

COPY noc_agent_reasoning.py ./

ENV PATH=/root/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Reasoning engine serves on the fixed port 8195 (see noc_agent_reasoning.py),
# matching the noc-ai-reasoning k8s Service.
EXPOSE 8195

RUN groupadd -r ndsep && useradd -r -g ndsep ndsep
USER ndsep

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -sf http://localhost:8195/health || exit 1

CMD ["python3", "noc_agent_reasoning.py"]
