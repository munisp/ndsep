FROM python:3.12-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ curl && rm -rf /var/lib/apt/lists/*
COPY ml_foundation/requirements.txt /build/requirements.txt
RUN pip install --no-cache-dir --prefix=/install torch==2.13.0+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --prefix=/install torch-geometric==2.8.0.post1 ray[train]==2.58.0 duckdb==1.5.5 pyarrow==25.0.1 scikit-learn==1.9.0 'numpy>=1.26,<3' 'fastapi>=0.104,<1' 'uvicorn[standard]>=0.24,<1' 'cryptography>=42,<51' 'pydantic>=2,<3'

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl libgomp1 && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 ndsepml && useradd --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin ndsepml
COPY --from=builder /install /usr/local
WORKDIR /app
COPY ml_foundation /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 NDSEP_ML_MODEL_DIR=/var/lib/ndsep-ml/models NDSEP_ML_PORT=8251
USER 10001:10001
EXPOSE 8251
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl --fail --silent http://127.0.0.1:8251/health || exit 1
CMD ["python3", "service.py"]
